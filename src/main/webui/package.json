{
	"name": "quarkus-mantleui",
	"version": "10.11.0",
	"description": "Quarkus monorepo demonstrating Quarkus REST server with Mantle UI client.",
	"homepage": ".",
	"private": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/melloware/quarkus-primereact.git"
	},
	"license": "MIT",
	"dependencies": {
		"@mantle-ui/flex": "^3.4.1",
		"@mantle-ui/icons": "^7.2.0",
		"@mantle-ui/react": "10.14.1",
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-query": "5.105.0",
		"axios": "1.21.0",
		"primelocale": "2.6.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-router-dom": "7.18.5",
		"react-transition-group": "4.4.5",
		"react-use-websocket": "4.13.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@tanstack/react-query-devtools": "5.105.0",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/react-router-dom": "5.3.3",
		"@types/react-transition-group": "4.4.12",
		"@vitejs/plugin-react": "6.2.1",
		"core-js": "3.51.0",
		"cross-env": "10.1.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.7",
		"orval": "8.47.0",
		"prettier": "3.9.10",
		"sass": "1.107.1",
		"typescript": "7.0.2",
		"vite": "8.3.6",
		"wait-on": "^9.5.1"
	},
	"scripts": {
		"format": "prettier --write \"{src,__tests__}/**/*.{ts,tsx}\"",
		"codegen": "wait-on -d 1000 ./openapi.yaml && orval && npm run format",
		"start": "npm run dev",
		"dev": "npm run codegen && vite",
		"build": "npm run codegen && vite build",
		"preview": "vite preview",
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
	}
}
